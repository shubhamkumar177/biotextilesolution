server_tokens off;
client_max_body_size 64k;

gzip on;
gzip_comp_level 5;
gzip_min_length 512;
gzip_vary on;
gzip_proxied any;
gzip_types text/css application/javascript application/json image/svg+xml text/plain application/xml;

limit_req_zone $binary_remote_addr zone=forms:10m rate=10r/m;

upstream biotextile_app {
    server app:3000;
    keepalive 16;
}

# HTTP: ACME challenge + redirect everything else to HTTPS
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${DOMAIN} ${DOMAIN_ALIASES};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name ${DOMAIN} ${DOMAIN_ALIASES};

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # Canonical host: www / aliases -> apex
    if ($host != "${DOMAIN}") {
        return 301 https://${DOMAIN}$request_uri;
    }

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;

    location /api/ {
        limit_req zone=forms burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://biotextile_app;
    }

    location /assets/ {
        access_log off;
        proxy_pass http://biotextile_app;
    }

    location / {
        proxy_pass http://biotextile_app;
    }
}
