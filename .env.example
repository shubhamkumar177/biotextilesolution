# Not secrets — public configuration only. Secrets live in AWS Secrets Manager (eu-west-1).
DOMAIN=biotextile.example.co.uk
# Space-separated extra hostnames on the certificate; they redirect to DOMAIN
DOMAIN_ALIASES=www.biotextile.example.co.uk
CERTBOT_EMAIL=ops@example.co.uk
# 1 = Let's Encrypt staging (for testing, avoids rate limits). Set 0 for real certs.
CERTBOT_STAGING=0

APP_SECRET_ID=biotextile/prod
# Only for non-EC2 hosts using a local AWS profile:
# AWS_PROFILE=default
# AWS_CONFIG_DIR=~/.aws

# Company details — legally required on the website once incorporated (Companies Act 2006)
COMPANY_NAME=Bio Textile Solution UK
COMPANY_NUMBER=
REGISTERED_OFFICE=
VAT_NUMBER=
CONTACT_EMAIL=
# Show indicative GBP pricing + BOM estimator on the site
SHOW_PRICING=true
